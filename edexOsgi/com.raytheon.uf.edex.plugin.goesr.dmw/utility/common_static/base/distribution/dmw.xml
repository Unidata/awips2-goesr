    <!-- TOWRdocs Header
        The distribution file for GOES-R and Himawari Derived Motion Winds
        (DMW) products
    -->
    <!-- TOWRdocs Description
        This file contains regex expressions used to match filename patterns to 
        the appropriate GOES-R or Himawari winds file. Any filename ingested that 
        any of the pattern(s) below will run through the DMWDecoder.
    -->
    <!-- TOWRdocs Status
        This file is currently in the baseline. It has been modified to include Himawari
        DMW product files as well.
        2/27/20 Modified GOES-R dmw pattern for IXTU89 (GOES-West) or IXTU99 (GOES-East)
        7/29/20 include full disk tile glm OR_ for GLM flash plots. This pattern is also in goesr.xml for GLM Grids
        10/15/20 Ice motion arrows, viirs fires, SCATSAT
        11/4/20 Ice motion from isatss, IR_
        11/10/20 Updates GLM, L2 only in pattern for dmw flash points
        5/5/21 Remove SCATSAT
        12/19/2021 Remove Ice Motion entry
        1/16/2023 Add GLM flash points sourced from SBN, commented
        6/8/2023 Add GOES Ice Motion IXTV SBN sourcing 
        9/24/2023 Remove GLM L2 flash points regional LDM
        9/28/2023 Per ER coord added ISS Ltng, avoids conflicts w/ER add-ons
        5/10/2024 OSCAT Winds
    -->
    <!-- TOWRdocs POC
        Lee Byerle 5/10/2024
    -->

<requestPatterns xmlns:ns2="group">
    <!-- Raw GOES-R Products --> 
    <regex>^.*(DMW[A-Z0-9]{1,}-M[0-9]C[0-9]{2}).*\.nc$</regex>
    <!-- WMO Header for GOES-R DMW -->
    <regex>^IXTU.*</regex>
    <!-- WMO Header for GOES-R Ice Motion -->
    <regex>^IXTV.*</regex>
    <!-- Raw Himawari Products -->
    <regex>^Himawari_AHI.*AMV_CH[0-9]{2}(_CS)?\.nc$</regex>
<!--GLM Full Disk Tiles Flash location -->
    <regex>^OR_GLM-L2-GLMF-M\d_G\d\d_T.*</regex>
<!--GLM Full Disk Stitched Files -->
    <regex>OR_GLM-L2-GLMF-M\d_G\d\d.*</regex>
<!--GLM Full Disk Tiles Flash location, SBN -->
<!--    <regex>^(TIR[ST]00.*)</regex> -->
<!--VIIRS Fires Polar Book Club m-band and i-band -->
    <regex>^viirs_fires.*</regex>
<!-- ISS Ltng -->
    <regex>^ISS_LIS.*</regex>
<!-- OSCAT-3 Winds  -->
    <regex>^isatssOSCAT_.*</regex>
</requestPatterns>
