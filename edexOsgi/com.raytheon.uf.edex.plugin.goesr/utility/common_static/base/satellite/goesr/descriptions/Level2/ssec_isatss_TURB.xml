<goesrProductDescriptions>

  <default>
    <matches>
     <match pattern="uwssec_isatss_L3-TURB(C|F|M1|M2)-M\d_G\d\d_T\d\d_s\d{14}_e\d{14}_c\d{14}.nc"> 
        <attribute name="dataset_name" />
      </match>
    </matches>
  </default>

  <description>
    <dataTime>
        <formattedRefTime dateFormat="yyyy-MM-dd'T'HH:mm:ss'Z'">
            <attribute name="time_coverage_start"/>
        </formattedRefTime>
    </dataTime>

    <source>
        <attribute name="production_site" />
    </source>

    <creatingEntity>
        <pattern inputPattern="G(1[6789])" outputFormat="GOES-%S">
            <attribute name="platform_ID" />
        </pattern>
    </creatingEntity>
  </description>

  
  <description>
    <data>
      <variable name="probability" />
    </data>
    <physicalElement>
      <value value="isatss_Turbulence_Probability" />
      <!--<value value="Turbulence_Probability" /> -->
    </physicalElement>
  </description>


</goesrProductDescriptions>
