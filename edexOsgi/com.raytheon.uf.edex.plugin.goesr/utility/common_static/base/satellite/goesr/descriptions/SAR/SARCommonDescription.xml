<goesrProductDescriptions>
  <default>
    <matches>
      <match pattern="isatssSARWIND_\w\w\w_\d{1,3}\w\d{1,3}\w_s\d{14}.nc">
        <attribute name="dataset_name" />
      </match>
    </matches>
  </default>

 <description>
    <dataTime>
        <formattedRefTime dateFormat="yyyy-MM-dd'T'HH:mm:ss'Z'">
            <attribute name="time_coverage_start"/>
        </formattedRefTime>
    </dataTime>

    <source>
        <attribute name="production_site" />
    </source>

    <sectorID>
        <value value="SAR" />
    </sectorID>

<!-- platform_ID such as RCM-3 -->
    <creatingEntity>
            <attribute name="platform_ID" />
    </creatingEntity> 
 </description>

  <description>
    <data>
      <variable name="sar_wind" />
      <discreteMask name="mask" value="-1" keep="true">
      <fillFloat>-999.</fillFloat>
      </discreteMask>
    </data>
    <physicalElement>
      <value value="sar_wind" />
    </physicalElement>
  </description>

  <description>
    <data>
      <variable name="icemask" />
    </data>
    <physicalElement>
      <value value="sar_icemask" /> 
    </physicalElement>
  </description> 

</goesrProductDescriptions>
