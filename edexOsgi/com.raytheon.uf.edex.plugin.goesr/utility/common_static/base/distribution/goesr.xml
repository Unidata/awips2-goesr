<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
    <!-- 
         Distribution file for GOES-R CMI and Level2 products. Added IXT.. expressions to recognize
         WMO headers for derived products.  The following headers are recognized: 

         IXTA - Aerosol Detection (ADP)
         IXTB - Aerosol Optical Depth  (AOD)
         IXTC - Cloud Cover Layers (CCL)
         IXTD - Cloud Top Phase (ACTP)
         IXTE - Fog and Low Stratus
         IXTF - Rainfall/QPE  (RRQPE)
         IXTG - Cloud Top Height (CTH)
         IXTH - Clear Sky Mask (CSM)
         IXTI - Cloud Top Temp (CTT)
         IXTJ - Fire Hot Spot Characterization (FDC)
         IXTK - Land Sfc (Skin) Temp (LST)
         IXTL - Fractional Snow Cover (FSC)
         IXTM - Sea Surface Temperature (SST)
         IXTN - Derived stability indices (DSI)
         IXTO - Total Precipitable Water (TPW)
         IXTP - Legacy Vertical Moisture Profile (LVM)
         IXTQ - Legacy Vertical Temperature Profile (LVT)
         IXTR - Ice Concentration and Extent
         IXTT - Ice Age and Thickness
         IXTV - Ice Motion (see dmw.xml), not used here
         IXTX - Cloud Top Pressure, GOES-East IXTX01, GOES-West IXTX81
         IXTY - Cloud Optical Depth, GOES-East IXTY01, GOES-West IXTY81
         IXTW - Cloud Particle Size, GOES-East IXTW01, GOES-West IXTW81
         IXTU - See dmw.xml. IXTU99 GOES-East on GRE channel, IXTU89 GOES-West is on GRW channel. 

         The WMO header for derived motion winds (DMW,IXTU) is
         not included here, see dmw.xml 

          12/12/2016 Updates ABI match pattern to account for:

         "OR" = OE Real-Time Data
         "OT" = OE Test Data
         "IR" = ITE Real-Time Data
         "IT" = ITE Test Data"

       8/5/2018  L. Byerle add TIU for G-17 Meso
       7/28/2020 L. Byerle add GLM full disk tiles. This pattern also appears in dmw.xml for GLM flash points
       11/5/2020 L. Byerle add CIMSS turbulence product tailored in isatss.
       11/6/2020 L. Byerle OR or DR as pattern start for ice conc and ice thickness
       1/18/2021 L. Byerle Updated to merge DAM with TOWR-S. Adds CLASS/CMIP Imagery pattern.
       4/19/2021 L. Byerle add Meso Fire Hotspot (FDC) for mesos via LDM
       5/5/2021  L. Byerle add ISatSS Geocolor, update CIRA entry to match DAM
       9/30/2021 L. Byerle update Cloud top pressure, cloud optical depth, cloud particle size
                 entry so that the 5th digit can be any digit to account for GOES-East (zero), and 
                 GOES-West (number 8)
       12/19/2021 L. Byerle remove Ice conc and thickness
       1/16/2023  L. Byerle add IXTT for Ice Age and Thickness. Update Comments.
       6/7/2023   L. Byerle added comment above regarding IXTV
       8/18/2023  L. Byerle IXTC description updated in comments above
       5/10/2024  L. Byerle SAR Winds
    -->
    <!--
        This is an absolute override file, indicating that a higher priority
        version of the file will completely replace a lower priority version
        of the file.
    -->
<requestPatterns xmlns:ns2="group">
    <!-- SSEC/CIMSS GOES-R Product REGEX Entries -->
    <regex>^SSEC_AII_.*_T\w{3}_\d{8}_\d{4,6}.nc$</regex>
    <regex>^SSEC_AII.*_viirs_sst.*_\d{8}_\d{4,6}.nc$</regex>
    <regex>^LDAD-GOESR-</regex>    
    <regex>^TI[SRU]</regex>
    <!-- This pattern is intended to match standardized Level 2 filenames, it will not be used over LDM -->
    <regex>^[OI][RT]_ABI-L2-\w{3,5}(C|F|M1|M2)-M[\d]_G\d\d_s\d{14}_e\d{14}_c\d{14}.nc$</regex>
    <regex>OR_ABI</regex>
    <regex>.*GOES.*.nc4</regex>
    <!--  Unidata GLM Gridded Products -->
    <regex>OR_GLM-L2-GLM</regex>
    <regex>OR_GLM-L3-GLM</regex>
    <!-- WMO headers for derived products -->
    <regex>^IXT[ABCDEFGHIJKLMNOPQRT]</regex>
    <!-- Cloud top pressure, cloud optical depth, cloud particle size -->
    <regex>^IXT[XYW]\d{2}.*</regex>
    <!-- Himawari Imagery -->
    <regex>^OR_HFD</regex>
    <regex>^H8FD.B</regex>
    <!--GOES turbulence from CIMSS isatss tailored for CONUS/PACUS -->
    <regex>^uwssec_isatss_L3-TURBC.*</regex>
    <!-- For CIRA GeoColor and DEBRA Dust Tiles -->
    <regex>^RAMMB</regex>
    <!-- ISatSS Geocolor -->
    <regex>^OR_ABI-L3-GEOC(A|C|F|M1|M2|P)-M\d.*</regex>
    <!-- SAR Winds -->
    <regex>^isatssSARWIND_.*</regex>  
</requestPatterns>
